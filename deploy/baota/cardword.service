[Unit]
Description=Card Word
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cardword
Group=cardword
WorkingDirectory=/opt/cardword
EnvironmentFile=/etc/cardword/cardword.env
ExecStart=/opt/cardword/cardword
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cardword
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
